{
  "bundleid": "io.github.x-o-r-r-o.media-toolkit",
  "name": "Media Toolkit",
  "description": "Resize, convert, rotate and clean images, remove backgrounds offline, and convert, compress or trim video and audio",
  "category": "Tools",
  "createdby": "x-o-r-r-o",
  "webaddress": "https://github.com/x-o-r-r-o/alfred-media-toolkit",
  "version": "1.0.0",
  "variablesdontexport": [],
  "config": [
    {
      "type": "textfield",
      "variable": "keyword_img",
      "label": "Keywords",
      "description": "Images selected in Finder",
      "config": {
        "default": "img",
        "placeholder": "img",
        "required": true,
        "trim": true
      }
    },
    {
      "type": "textfield",
      "variable": "keyword_vid",
      "label": "",
      "description": "Video and audio selected in Finder",
      "config": {
        "default": "vid",
        "placeholder": "vid",
        "required": true,
        "trim": true
      }
    },
    {
      "type": "textfield",
      "variable": "keyword_media",
      "label": "",
      "description": "Everything for the Finder selection",
      "config": {
        "default": "media",
        "placeholder": "media",
        "required": true,
        "trim": true
      }
    },
    {
      "type": "textfield",
      "variable": "output_suffix",
      "label": "Output",
      "description": "Added to the file name when the format stays the same. Existing files are never overwritten: a number is added instead.",
      "config": {
        "default": "-edited",
        "placeholder": "-edited",
        "required": false,
        "trim": false
      }
    },
    {
      "type": "checkbox",
      "variable": "replace_originals",
      "label": "",
      "description": "Only when the format stays the same and the file is writable.",
      "config": {
        "default": false,
        "required": false,
        "text": "Replace the original files"
      }
    },
    {
      "type": "checkbox",
      "variable": "keep_dates",
      "label": "",
      "description": "Results get the modification and creation dates of the original, so they sort next to it.",
      "config": {
        "default": false,
        "required": false,
        "text": "Keep the original dates"
      }
    },
    {
      "type": "popupbutton",
      "variable": "image_quality",
      "label": "Quality",
      "description": "JPEG, HEIC, AVIF and WebP",
      "config": {
        "default": "85",
        "pairs": [
          [
            "100%",
            "100"
          ],
          [
            "95%",
            "95"
          ],
          [
            "90%",
            "90"
          ],
          [
            "85%",
            "85"
          ],
          [
            "80%",
            "80"
          ],
          [
            "75%",
            "75"
          ],
          [
            "70%",
            "70"
          ],
          [
            "60%",
            "60"
          ],
          [
            "50%",
            "50"
          ]
        ]
      }
    },
    {
      "type": "popupbutton",
      "variable": "gif_width",
      "label": "GIF from video",
      "description": "Maximum width",
      "config": {
        "default": "480",
        "pairs": [
          [
            "320 px",
            "320"
          ],
          [
            "480 px",
            "480"
          ],
          [
            "640 px",
            "640"
          ],
          [
            "800 px",
            "800"
          ],
          [
            "1080 px",
            "1080"
          ],
          [
            "Original size",
            "0"
          ]
        ]
      }
    },
    {
      "type": "popupbutton",
      "variable": "gif_fps",
      "label": "",
      "description": "Frame rate",
      "config": {
        "default": "15",
        "pairs": [
          [
            "10 fps",
            "10"
          ],
          [
            "12 fps",
            "12"
          ],
          [
            "15 fps",
            "15"
          ],
          [
            "20 fps",
            "20"
          ],
          [
            "24 fps",
            "24"
          ],
          [
            "30 fps",
            "30"
          ]
        ]
      }
    },
    {
      "type": "textfield",
      "variable": "ffmpeg_path",
      "label": "ffmpeg",
      "description": "Optional. Found automatically in /opt/homebrew/bin, /usr/local/bin or the PATH.",
      "config": {
        "default": "",
        "placeholder": "/path/to/ffmpeg",
        "required": false,
        "trim": true
      }
    }
  ],
  "objects": [
    {
      "id": "sf_img",
      "type": "scriptfilter",
      "keyword": "{var:keyword_img}",
      "title": "Edit Images",
      "subtext": "Resize, convert, rotate, clean or remove the background of the Finder selection",
      "script": "osascript -l JavaScript ./media.js img \"$1\"",
      "running": "Reading the Finder selection…"
    },
    {
      "id": "sf_vid",
      "type": "scriptfilter",
      "keyword": "{var:keyword_vid}",
      "title": "Convert Video and Audio",
      "subtext": "MP4, WebM, GIF, MP3, compress, resize, trim the Finder selection",
      "script": "osascript -l JavaScript ./media.js vid \"$1\"",
      "running": "Reading the Finder selection…"
    },
    {
      "id": "ua_media",
      "type": "universalaction",
      "name": "Media Toolkit",
      "files": true,
      "multi": 1
    },
    {
      "id": "ua_files",
      "type": "argument",
      "argument": "",
      "variables": {
        "mt_ua_files": "{query}"
      },
      "note": "Hands the selected files to the Script Filter as a variable"
    },
    {
      "id": "sf_media",
      "type": "scriptfilter",
      "keyword": "{var:keyword_media}",
      "title": "Media Toolkit",
      "subtext": "Image, video and audio operations for the Finder selection",
      "script": "osascript -l JavaScript ./media.js all \"$1\"",
      "running": "Reading the files…"
    },
    {
      "id": "action",
      "type": "script",
      "script": "./action.sh \"$1\"",
      "note": "Images run now; video and audio are queued for worker.sh"
    },
    {
      "id": "notify",
      "type": "notification"
    },
    {
      "id": "ext_notify",
      "type": "external",
      "trigger": "notify",
      "note": "Called by worker.sh when a background conversion finishes"
    }
  ],
  "connections": [
    {
      "from": "ua_media",
      "to": "ua_files"
    },
    {
      "from": "ua_files",
      "to": "sf_media"
    },
    {
      "from": "sf_img",
      "to": "action"
    },
    {
      "from": "sf_img",
      "to": "action",
      "mod": "cmd"
    },
    {
      "from": "sf_img",
      "to": "action",
      "mod": "alt"
    },
    {
      "from": "sf_vid",
      "to": "action"
    },
    {
      "from": "sf_vid",
      "to": "action",
      "mod": "cmd"
    },
    {
      "from": "sf_vid",
      "to": "action",
      "mod": "alt"
    },
    {
      "from": "sf_media",
      "to": "action"
    },
    {
      "from": "sf_media",
      "to": "action",
      "mod": "cmd"
    },
    {
      "from": "sf_media",
      "to": "action",
      "mod": "alt"
    },
    {
      "from": "action",
      "to": "notify"
    },
    {
      "from": "ext_notify",
      "to": "notify"
    }
  ]
}